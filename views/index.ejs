<!DOCTYPE html>
<html lang="id" x-data="Object.assign(controllerApp, { 
    activeTab: sessionStorage.getItem('hasLoggedIn') ? sessionStorage.getItem('currentTab') || 'overview' : 'overview' })" 
    x-init="
        if (!sessionStorage.getItem('hasLoggedIn')) {
            sessionStorage.setItem('hasLoggedIn', 'true');
            sessionStorage.setItem('currentTab', 'overview');
        }
        $watch('activeTab', value => sessionStorage.setItem('currentTab', value));
    " 
    :class="{ 'dark': darkMode }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/img/favicon.png">
  <title>ZeroDash Mikrotik</title>
  
  <link rel="stylesheet" href="/css/style.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: { colors: { darkbg: '#0B1120', cardbg: '#1E293B', accent: '#06B6D4' } }
      }
    }
  </script>

  <script>
    window.USER_ROLE = '<%= currentUser ? currentUser.role : "read_only" %>';
  </script>
  
  <script defer src="/js/alpine.min.js"></script>
  <script type="text/javascript" src="/js/vis-network.min.js"></script>

  <script src="/lucide/umd/lucide.js"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<!-- Gunakan h-screen dan overflow-hidden agar body tidak ikut scroll -->
<body class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 h-screen flex flex-col md:flex-row antialiased overflow-hidden transition-colors duration-200">

  <!-- Sidebar akan diam di tempat -->
  <%- include('partials/sidebar') %>

  <!-- Area konten utama yang akan di-scroll sendiri secara mandiri -->
  <main class="flex-1 flex flex-col h-full overflow-y-auto">
    <%- include('partials/header') %>

    <div class="p-4 md:p-6 space-y-6 flex-1">
      
      <!-- MENU 0: OVERVIEWS -->
      <div x-show="activeTab === 'overview'" style="display: none;">
        <%- include('overview') %>
      </div>

      <!-- MENU 1: CONTROLLER NETWORKS -->
      <div x-show="activeTab === 'networks'" style="display: none;">
        <%- include('pages/networks') %>
      </div>

      <!-- MENU 2: CONTROLLER MEMBERS -->
      <div x-show="activeTab === 'members'" style="display: none;">
        <%- include('pages/members') %>
      </div>

      <!-- MENU 3: CONTROLLER ROUTES -->
      <div x-show="activeTab === 'routes'" style="display: none;">
        <%- include('pages/routes') %>
      </div>

      <!-- MENU 4: REMOTE ROUTER TOOL -->
      <div x-show="activeTab === 'remote-router'" style="display: none;">
        <%- include('pages/remote-router') %>
      </div>

      <!-- MENU 5: MASTER ROUTER -->
      <div x-show="activeTab === 'master-router'" style="display: none;">
        <%- include('pages/master-router') %>
      </div>

      <!-- MENU 6: SETTINGS -->
      <div x-show="activeTab === 'settings'" style="display: none;">
        <%- include('pages/settings') %>
      </div>

      <!-- MENU 7: USER MANAGEMENT -->
      <% if (currentUser && currentUser.role === 'admin') { %>
      <div x-show="activeTab === 'users'" style="display: none;">
        <%- include('pages/users') %>
      </div>
      <% } %>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm">
        <h4 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2">Controller API Live Output Log</h4>
        <div class="bg-slate-950 rounded-lg p-3 font-mono text-[11px] h-32 overflow-y-auto space-y-2 border border-slate-800/80">
          <template x-for="log in logs" :key="log.time + log.message">
            <div class="grid grid-cols-[85px_70px_1fr] items-start gap-2 pb-1.5">
              <span class="text-slate-500 pt-0.5" x-text="`[${log.time}]`"></span>
              <div>
                <span class="font-bold px-1.5 py-0.5 rounded text-[10px] inline-block" :class="log.type === 'SUCCESS' ? 'bg-emerald-500/20 text-emerald-400' : (log.type === 'ERROR' ? 'bg-rose-500/20 text-rose-400' : 'bg-cyan-500/20 text-cyan-400')" x-text="log.type"></span>
              </div>
              <span class="text-slate-300 break-words whitespace-normal" x-text="log.message"></span>
            </div>
          </template>
        </div>
      </div>

    </div>
  </main>

  <%- include('partials/modals') %>

  <script src="/js/app.js"></script>
  <script>
    // Jalankan saat pertama kali halaman dimuat
    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
    setInterval(() => {
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }, 500);
  </script>
</body>
</html>