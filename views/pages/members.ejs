<div x-show="activeTab === 'members'" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
  <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
    <div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-200">ZeroTier Controller Members</h3>
      <p class="text-xs text-slate-400">Kelola otorisasi, virtual IP, dan device member controller.</p>
    </div>
    <div x-show="window.USER_ROLE === 'admin'">
      <button @click="openAddMemberModal()" class="px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold shadow flex items-center space-x-1.5 transition">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        <span>Tambah Member</span>
      </button>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs min-w-[900px]">
      <thead class="bg-slate-50 dark:bg-slate-950 text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 uppercase font-semibold">
        <tr>
          <th class="p-3.5">ID</th>
          <th class="p-3.5">Nama Member</th>
          <th class="p-3.5">Network</th>
          <th class="p-3.5">Virtual IP Address</th>
          <th class="p-3.5">ZT-Address</th>
          <th class="p-3.5">Last Seen</th>
          <th class="p-3.5">Status Otorisasi</th>
          <th class="p-3.5 text-center" x-show="window.USER_ROLE === 'admin'">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
        <template x-for="m in members" :key="m['.id'] || m['zt-address']">
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <td class="p-3.5 font-bold font-mono text-cyan-600 dark:text-cyan-400" x-text="m['.id']"></td>
            <td class="p-3.5 font-bold text-slate-900 dark:text-slate-100" x-text="m.name || '-' "></td>
            <td class="p-3.5 font-mono text-slate-400" x-text="m.network || '-'"></td>
            <td class="p-3.5 font-mono font-semibold text-emerald-600 dark:text-emerald-400" x-text="m['ip-address'] || m.ip || 'Unassigned'"></td>
            <td class="p-3.5 font-mono text-cyan-500" x-text="m['zt-address'] || m['zts-id'] || '-'"></td>
            <td class="p-3.5 font-mono text-slate-400" x-text="m['last-seen'] || 'Online'"></td>
            <td class="p-3.5">
              <span :class="parseBool(m.authorized) ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border-rose-500/20'" class="px-2.5 py-0.5 rounded text-[11px] font-semibold border" x-text="parseBool(m.authorized) ? 'AUTHORIZED' : 'DENIED'"></span>
            </td>
            <td class="p-3.5 text-center" x-show="window.USER_ROLE === 'admin'">
              <div class="flex items-center justify-center space-x-1.5">
                <!-- Tombol Status Auth (Toggle Icon) -->
                <button @click="toggleAuth(m['.id'], m.authorized)" 
                        :class="parseBool(m.authorized) ? 'bg-amber-500/10 hover:bg-amber-500/20 text-amber-500 border-amber-500/30' : 'bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-500 border-emerald-500/30'" 
                        class="p-1.5 rounded border transition" 
                        :title="parseBool(m.authorized) ? 'Klik untuk Revoke' : 'Klik untuk Authorize'">
                  <template x-if="parseBool(m.authorized)">
                    <i data-lucide="monitor-x" class="w-3.5 h-3.5"></i>
                  </template>
                  <template x-if="!parseBool(m.authorized)">
                    <i data-lucide="monitor-check" class="w-3.5 h-3.5"></i>
                  </template>
                </button>
                
                <!-- Tombol Edit Ikon -->
                <button @click="openEditMemberModal(m)" class="p-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded border border-slate-200 dark:border-slate-700 transition" title="Edit">
                  <i data-lucide="edit" class="w-3.5 h-3.5"></i>
                </button>
                
                <!-- Tombol Hapus Ikon -->
                <button @click="openDeleteMemberModal(m)" class="p-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 rounded border border-rose-500/30 transition" title="Hapus">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>
</div>