<div x-show="activeTab === 'overview'" class="space-y-6 pt-4" x-cloak
     x-init="
        $nextTick(() => {
            if (networks && networks.length > 0) {
                window.initAllTopologies(networks, members, peers, trafficData, parseBool);
            }
        });

        $watch('networks', () => {
            if (window.activeTab === 'overview' && networks && networks.length > 0) {
                $nextTick(() => window.initAllTopologies(networks, members, peers, trafficData, parseBool));
            }
        });

        $watch('darkMode', () => {
            if (window.activeTab === 'overview' && networks && networks.length > 0) {
                $nextTick(() => window.initAllTopologies(networks, members, peers, trafficData, parseBool));
            }
        });
     ">
  
  <!-- 1. HEADER OVERVIEW -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm flex flex-col md:flex-row md:items-center md:justify-between gap-4 transition-colors">
    <div>
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Network Topology & System Overview</h3>
      <p class="text-xs text-slate-400 mt-0.5">High-Performance Enterprise Topology with Real-Time Auto-Refresh & Dynamic Theme.</p>
    </div>
  </div>

  <!-- 2. QUICK STATS CARDS -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm transition-colors">
      <span class="text-xs text-slate-400 uppercase font-semibold">Controller</span>
      <div class="flex items-center justify-between mt-2">
        <h4 class="text-2xl font-bold text-slate-800 dark:text-slate-100" x-text="networks.length">0</h4>
        <i data-lucide="globe" class="w-5 h-5 text-cyan-500"></i>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm transition-colors">
      <span class="text-xs text-slate-400 uppercase font-semibold">Instance</span>
      <div class="flex items-center justify-between mt-2">
        <h4 class="text-2xl font-bold text-slate-800 dark:text-slate-100" x-text="instances.length">0</h4>
        <i data-lucide="notebook-tabs" class="w-5 h-5 text-amber-500"></i>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm transition-colors">
      <span class="text-xs text-slate-400 uppercase font-semibold">Members</span>
      <div class="flex items-center justify-between mt-2">
        <h4 class="text-2xl font-bold text-slate-800 dark:text-slate-100" x-text="members.length">0</h4>
        <i data-lucide="users" class="w-5 h-5 text-emerald-500"></i>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 shadow-sm transition-colors">
      <span class="text-xs text-slate-400 uppercase font-semibold">Controller Status</span>
      <div class="flex items-center justify-between mt-2">
        <h4 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400" x-text="networks.length > 0 ? 'Active Hub' : 'Standby'">- - -</h4>
        <i data-lucide="shield-check" class="w-5 h-5 text-indigo-500"></i>
      </div>
    </div>
  </div>

  <!-- 3. CONTAINER UTAMA CYTOSCAPE -->
  <div class="space-y-8 mt-6">
    <template x-for="net in networks" :key="net['.id'] || net.network">
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-5 shadow-sm transition-colors">
        <div class="relative w-full rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#020617] transition-colors mt-2">
          <div class="absolute inset-0 bg-[linear-gradient(to_right,#cbd5e1_1px,transparent_1px),linear-gradient(to_bottom,#cbd5e1_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:2rem_2rem] pointer-events-none opacity-40 transition-colors"></div>
          
          <!-- Wadah Kanvas Cytoscape -->
          <div :id="'cy_' + String(net['.id'] || net.network).replace(/[^a-zA-Z0-9]/g, '')" class="w-full h-[650px] relative outline-none cursor-grab active:cursor-grabbing"></div>
        </div>
      </div>
    </template>

    <template x-if="networks.length === 0">
      <div class="text-center text-xs text-slate-500 italic py-10 bg-white dark:bg-slate-950 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-400">
        Belum ada data Controller Network yang terdeteksi pada sistem.
      </div>
    </template>
  </div>
</div>

<!-- Load CDN Cytoscape.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>

<script>
if (!window.cyInstances) {
    window.cyInstances = {};
}

async function fetchServerPositions() {
    try {
        const res = await fetch('/api/topology/positions');
        if (res.ok) return await res.json();
    } catch (e) {}
    return {};
}

async function saveServerPositions(positionsObj) {
    try {
        const res = await fetch('/api/topology/positions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(positionsObj)
        });
        const json = await res.json();
        console.log('Save Position Response:', json);
    } catch (e) {
        console.error('Error saving position:', e);
    }
}

window.initAllTopologies = async function(networks, members, peersData, trafficData, parseBoolHelper) {
    if (typeof cytoscape === 'undefined') return;

    let activePeers = peersData || [];
    if (activePeers.length === 0) {
        try {
            const res = await fetch('/api/controller/peers');
            const json = await res.json();
            if (json.success) activePeers = json.data || [];
        } catch (e) {}
    }

    const checkBool = (val) => {
        if (parseBoolHelper) return parseBoolHelper(val);
        return String(val) === 'true' || val === true || val === '*1';
    };

    const isDarkMode = document.documentElement.classList.contains('dark') || 
                       document.body.classList.contains('dark') || 
                       document.documentElement.getAttribute('data-theme') === 'dark';

    // Tarik posisi dari database
    const storedPositions = await fetchServerPositions();

    const parseMikrotikTime = (timeStr) => {
        if (!timeStr || timeStr.toLowerCase().includes('offline')) return 999999;
        if (timeStr.toLowerCase() === 'active') return 0;
        let totalSeconds = 0;
        const days = timeStr.match(/(\d+)d/);
        const hours = timeStr.match(/(\d+)h/);
        const mins = timeStr.match(/(\d+)m(?!s)/); 
        const secs = timeStr.match(/(\d+)s/);
        if (days) totalSeconds += parseInt(days[1]) * 86400;
        if (hours) totalSeconds += parseInt(hours[1]) * 3600;
        if (mins) totalSeconds += parseInt(mins[1]) * 60;
        if (secs) totalSeconds += parseInt(secs[1]);
        return totalSeconds;
    };

    setTimeout(() => {
        (networks || []).forEach((net) => {
            const netKey = String(net['.id'] || net.network).replace(/[^a-zA-Z0-9]/g, '');
            const containerId = 'cy_' + netKey;
            const container = document.getElementById(containerId);
            if (!container) return;

            // KUNCI ID PERMANEN: Gunakan Network ID asli yang unik sebagai basis ID Controller
            const rawNetId = net.network || net['network-id'] || net['.id'] || 'net';
            const cleanNetId = String(rawNetId).replace(/[^a-zA-Z0-9]/g, '');
            const ctrlId = 'ctrl_' + cleanNetId;
            const elements = [];

            const isPrivateNet = checkBool(net.private) || String(net.private) === 'true' || net.private === '*1';
            const controllerSubnet = net['ip-range'] || net.subnet || net['assigned-address'] || net.address || 'Managed Subnet';
            const controllerIdText = net.network || net['network-id'] || net['.id'] || '-';

            const networkMembers = (members || []).filter(m => {
                const netId = net['.id'] || ''; 
                const netNetwork = net.network || net['network-id'] || ''; 
                const itemNetwork = m.network || '';
                return itemNetwork === netId || itemNetwork === net.name || itemNetwork === netNetwork || !itemNetwork;
            });

            const activeCount = networkMembers.filter(m => checkBool(m.authorized) && !(String(m.online) === 'false' || (m['last-seen'] || '').toLowerCase().includes('offline'))).length;
            const pendingCount = networkMembers.filter(m => !checkBool(m.authorized)).length;
            const offlineCount = networkMembers.filter(m => checkBool(m.authorized) && (String(m.online) === 'false' || (m['last-seen'] || '').toLowerCase().includes('offline'))).length;

            // 1. Controller Node (Sesuai Desain Gambar 1)
            let ctrlPos = storedPositions[ctrlId];
            const controllerDisplayText = `========================================\n` +
                                          `\n` +
                                          `📌 ${net.name || 'ZT Controller'}\n` +
                                          `\n` +
                                          `----------------------------------------\n` +
                                          `ID: ${controllerIdText}\n` +
                                          `Subnet: ${controllerSubnet}\n` +
                                          `----------------------------------------\n` +
                                          `Members : \n` +
                                          `Active: ${activeCount} | Pend: ${pendingCount} | Off: ${offlineCount}\n` +
                                          `========================================`;

            elements.push({
                group: 'nodes',
                data: {
                    id: ctrlId,
                    label: controllerDisplayText,
                    status: isPrivateNet ? 'PRIVATE' : 'PUBLIC',
                    type: 'controller'
                },
                position: (ctrlPos && ctrlPos.x !== undefined && ctrlPos.y !== undefined) ? { x: parseFloat(ctrlPos.x), y: parseFloat(ctrlPos.y) } : undefined
            });

            // 2. Members & Edges (Sesuai Desain Gambar 2)
            networkMembers.forEach((m) => {
                // KUNCI ID PERMANEN MEMBER: Gunakan ZT-Address atau .id member yang unik & tetap di router
                const rawZtAddress = m['zt-address'] || m['zts-id'] || m['.id'] || 'mem';
                const cleanZtAddress = String(rawZtAddress).replace(/[^a-zA-Z0-9]/g, '');
                const mId = `mem_${cleanNetId}_${cleanZtAddress}`;

                const memberIp = (m['ip-address'] || m.ip || '').trim();
                const isAuth = checkBool(m.authorized);
                const lastSeenText = m['last-seen'] || 'Active';
                const secsOffline = parseMikrotikTime(lastSeenText);

                const matchedPeer = (activePeers || []).find(p => {
                    const pZt = String(p['zt-address'] || '').toLowerCase().replace(/[^a-z0-9]/g, '');
                    const pPath = String(p['path'] || '').toLowerCase();
                    return (cleanZtAddress && pZt.includes(cleanZtAddress)) || (memberIp && pPath.includes(memberIp));
                });

                let latencyValue = matchedPeer && matchedPeer.latency ? matchedPeer.latency : (secsOffline === 0 ? 'Active' : 'Offline');

                let status = 'ONLINE';
                if (!isAuth) status = 'PENDING';
                else if (String(m.online) === 'false' || lastSeenText.toLowerCase().includes('offline') || secsOffline > 15) status = 'OFFLINE';

                const tData = trafficData || {};
                const nodeTraffic = tData[memberIp] || tData[rawZtAddress] || tData[m.name] || { uploadFormatted: '0 bps', downloadFormatted: '0 bps' };
                let memPos = storedPositions[mId];

                const memberDisplayText = `========================================\n` +
                                      `\n` +
                                      `🖥️ ${m.name || 'Member Node'}\n` +
                                      `\n` +
                                      `----------------------------------------\n` +
                                      `ID: ${rawZtAddress} | IP: ${memberIp || 'N/A'}\n` +
                                      `----------------------------------------\n` +
                                      `Upload   : ${nodeTraffic.uploadFormatted || '0 bps'} | Download : ${nodeTraffic.downloadFormatted || '0 bps'}\n` +
                                      `Last-Seen    : ${lastSeenText}\n` +
                                      `Latency  : ${latencyValue}\n` +
                                      `----------------------------------------\n` +
                                      `Status: ${status}\n` +
                                      `========================================`;

                elements.push({
                    group: 'nodes',
                    data: {
                        id: mId,
                        label: memberDisplayText,
                        status: status,
                        type: 'member'
                    },
                    position: (memPos && memPos.x !== undefined && memPos.y !== undefined) ? { x: parseFloat(memPos.x), y: parseFloat(memPos.y) } : undefined
                });

                elements.push({
                    group: 'edges',
                    data: {
                        id: `edge_${ctrlId}_${mId}`,
                        source: ctrlId,
                        target: mId,
                        status: status
                    }
                });
            });

            // Jika instance sudah ada, update data teks dan status saja tanpa merusak posisi
            if (window.cyInstances[netKey]) {
                const cy = window.cyInstances[netKey];
                
                cy.batch(() => {
                    elements.forEach(ele => {
                        const target = cy.$('#' + ele.data.id);
                        if (target.length > 0) {
                            target.data({
                                label: ele.data.label,
                                status: ele.data.status
                            });
                        } else {
                            cy.add(ele);
                        }
                    });

                    const currentEleIds = elements.map(e => e.data.id);
                    cy.elements().forEach(ele => {
                        if (!currentEleIds.includes(ele.id())) {
                            cy.remove(ele);
                        }
                    });
                });

                return; 
            }

            const hasCustomPositions = elements.some(ele => ele.position && ele.position.x !== undefined);

            const cy = cytoscape({
                container: container,
                elements: elements,
                style: [
                    {
                        selector: 'node',
                        style: {
                            'label': 'data(label)',
                            'text-wrap': 'wrap',
                            'color': '#f8fafc',
                            'font-size': '12px',
                            'font-family': 'monospace',
                            'font-weight': 'bold',
                            'text-valign': 'center',
                            'text-halign': 'center',
                            'background-color': '#1e293b',
                            'border-width': '3px',
                            'border-color': '#10b981',
                            'width': '320px',      // Lebar card disesuaikan
                            'height': '150px',     // Tinggi card diperbesar vertikal agar muat semua baris
                            'shape': 'round-rectangle',
                            'padding': '10px'
                        }
                    },
                    {
                        selector: 'node[type = "controller"]',
                        style: {
                            'background-color': '#3b82f6',
                            'border-color': '#60a5fa',
                            'width': '330px',
                            'height': '150px',
                            'shadow-color': '#3b82f6'
                        }
                    },
                    {
                        selector: 'node[status = "ONLINE"]',
                        style: { 
                            'border-color': '#10b981',
                            'shadow-color': '#10b981'
                        }
                    },
                    {
                        selector: 'node[status = "PENDING"]',
                        style: { 
                            'border-color': '#f59e0b',
                            'shadow-color': '#f59e0b'
                        }
                    },
                    {
                        selector: 'node[status = "OFFLINE"]',
                        style: { 
                            'border-color': '#f43f5e',
                            'shadow-color': '#f43f5e',
                            'opacity': 0.85 
                        }
                    },
                    {
                        selector: 'edge',
                        style: {
                            'width': 4,
                            'line-color': '#10b981',
                            'curve-style': 'bezier',
                            'opacity': 0.8
                        }
                    },
                    {
                        selector: 'edge[status = "PENDING"]',
                        style: { 
                            'line-color': '#f59e0b',
                            'line-style': 'dashed',
                            'line-dash-pattern': [6, 6]
                        }
                    },
                    {
                        selector: 'edge[status = "OFFLINE"]',
                        style: { 
                            'line-color': '#f43f5e',
                            'line-style': 'dashed',
                            'line-dash-pattern': [8, 4],
                            'opacity': 0.5 
                        }
                    }
                ],
                layout: {
                    name: hasCustomPositions ? 'preset' : 'cose',
                    animate: false,
                    nodeRepulsion: 1200000,
                    idealEdgeLength: 180
                },
                interaction: {
                    dragNodes: true,
                    zoomEnabled: true,
                    panEnabled: true
                }
            });

            cy.ready(() => {
                cy.resize();
                if (!hasCustomPositions) {
                    cy.fit();
                }
            });

            // Simpan posisi ke server dengan ID permanen yang berbasis ZT-Address
            cy.on('free', 'node', async function(evt) {
                const node = evt.target;
                const pos = node.position();
                console.log('🖱️ Node berhasil digeser (free):', node.id(), 'Posisi:', pos);

                try {
                    const currentStored = await fetchServerPositions();
                    currentStored[node.id()] = { x: pos.x, y: pos.y };

                    const res = await fetch('/api/topology/positions', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(currentStored)
                    });
                    const json = await res.json();
                    console.log('📡 Respon Server Simpan Posisi:', json);
                } catch (err) {
                    console.error('❌ Gagal kirim posisi ke server:', err);
                }
            });

            window.cyInstances[netKey] = cy;
        });
    }, 150);
};
</script>