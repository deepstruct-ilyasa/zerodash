<!-- ========================================== -->
<!-- 1. MODAL FORM TAMBAH / EDIT INTERFACE ZERO-TIER -->
<!-- ========================================== -->
<div x-show="showModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display: none;">
  <div @click.outside="showModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-lg shadow-xl">
    <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-4" x-text="isEdit ? 'Edit Interface ZeroTier' : 'Tambah Interface ZeroTier'"></h4>
    
    <form @submit.prevent="submitForm()" class="space-y-3 text-xs">
      
      <!-- NAMA INTERFACE -->
      <div>
        <label class="block text-slate-400 mb-1">Nama Interface</label>
        <input type="text" x-model="form.name" required class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200">
      </div>
      
      <!-- DROPDOWN INSTANCE -->
      <div>
        <label class="block text-slate-400 mb-1">Instance</label>
        <select x-model="form.instance" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200">
          <option value="">-- Pilih Instance --</option>
          <template x-for="ins in resultData.instance" :key="ins['.id'] || ins.name">
            <option :value="ins.name" x-text="ins.name + ' (Port: ' + (ins.port || '9993') + ')'"></option>
          </template>
        </select>
      </div>

      <!-- NETWORK ID -->
      <div>
        <label class="block text-slate-400 mb-1">Network ID</label>
        <input type="text" x-model="form.network" required class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>

      <!-- TOGGLE SWITCH UNTUK STATUS (DISABLED / RUNNING) -->
      <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl p-3 space-y-2 mt-2">
        <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Interface Status</span>
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[10px] text-slate-400 block" x-text="form.disabled === 'true' || form.disabled === true || form.disabled === 'yes' ? 'Status: Disabled (Mati)' : 'Status: Running (Aktif)'"></span>
          </div>
          <button type="button" 
                  @click="form.disabled = (form.disabled === 'true' || form.disabled === true || form.disabled === 'yes' ? 'false' : 'true')"
                  class="w-10 h-5 flex items-center rounded-full p-1 transition-colors duration-300"
                  :class="(form.disabled === 'true' || form.disabled === true || form.disabled === 'yes') ? 'bg-rose-600' : 'bg-emerald-600'">
            <div class="bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-300"
                 :class="(form.disabled === 'true' || form.disabled === true || form.disabled === 'yes') ? 'translate-x-5' : 'translate-x-0'"></div>
          </button>
        </div>
      </div>

      <!-- TOGGLE SWITCH UNTUK ALLOW CONFIG -->
      <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl p-3 space-y-3 mt-2">
        <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">Allow Configuration Flags</span>
        
        <!-- Toggle Allow Managed -->
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-300 font-medium">Allow Managed</span>
          <button type="button" 
                  @click="form['allow-managed'] = (form['allow-managed'] === 'yes' ? 'no' : 'yes')"
                  class="w-10 h-5 flex items-center rounded-full p-1 transition-colors duration-300"
                  :class="form['allow-managed'] === 'yes' ? 'bg-cyan-600' : 'bg-slate-700'">
            <div class="bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-300"
                 :class="form['allow-managed'] === 'yes' ? 'translate-x-5' : 'translate-x-0'"></div>
          </button>
        </div>

        <!-- Toggle Allow Global -->
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-300 font-medium">Allow Global</span>
          <button type="button" 
                  @click="form['allow-global'] = (form['allow-global'] === 'yes' ? 'no' : 'yes')"
                  class="w-10 h-5 flex items-center rounded-full p-1 transition-colors duration-300"
                  :class="form['allow-global'] === 'yes' ? 'bg-cyan-600' : 'bg-slate-700'">
            <div class="bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-300"
                 :class="form['allow-global'] === 'yes' ? 'translate-x-5' : 'translate-x-0'"></div>
          </button>
        </div>

        <!-- Toggle Allow Default -->
        <div class="flex items-center justify-between">
          <span class="text-slate-700 dark:text-slate-300 font-medium">Allow Default</span>
          <button type="button" 
                  @click="form['allow-default'] = (form['allow-default'] === 'yes' ? 'no' : 'yes')"
                  class="w-10 h-5 flex items-center rounded-full p-1 transition-colors duration-300"
                  :class="form['allow-default'] === 'yes' ? 'bg-cyan-600' : 'bg-slate-700'">
            <div class="bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-300"
                 :class="form['allow-default'] === 'yes' ? 'translate-x-5' : 'translate-x-0'"></div>
          </button>
        </div>
      </div>

      <!-- TOMBOL AKSI -->
      <div class="flex justify-end space-x-2 pt-4">
        <button type="button" @click="showModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg">Batal</button>
        <button type="submit" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg font-semibold" x-text="isEdit ? 'Simpan Perubahan' : 'Tambah'"></button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- 2. MODAL KONFIRMASI DELETE INTERFACE       -->
<!-- ========================================== -->
<div x-show="showDeleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display: none;">
  <div @click.outside="showDeleteModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-sm shadow-xl text-center">
    <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto mb-3">
      <i data-lucide="alert-triangle" class="w-6 h-6"></i>
    </div>
    <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Hapus Interface ZeroTier?</h4>
    <p class="text-xs text-slate-400 mb-4">Tindakan ini akan menghapus konfigurasi <span class="text-slate-200 font-mono font-semibold" x-text="deleteTargetName"></span> secara permanen dari router.</p>
    
    <div class="flex space-x-2 justify-center">
      <button type="button" @click="showDeleteModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs rounded-lg font-medium">Batal</button>
      <button type="button" @click="confirmDelete()" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs rounded-lg font-semibold transition">Ya, Hapus</button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 3. MODAL TAMBAH / EDIT INSTANCE            -->
<!-- ========================================== -->
<div x-show="showInstanceModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display: none;">
  <div @click.outside="showInstanceModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-md shadow-xl">
    <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-4" x-text="isEdit ? 'Edit ZeroTier Instance' : 'Tambah ZeroTier Instance'"></h4>
    
    <form @submit.prevent="submitInstanceForm()" class="space-y-3 text-xs">
      <div>
        <label class="block text-slate-400 mb-1">Instance Name</label>
        <input type="text" x-model="instanceForm.name" required placeholder="zt1" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>
      
      <div>
        <label class="block text-slate-400 mb-1">Port (ZeroTier Instance Port)</label>
        <input type="number" x-model="instanceForm.ztPort" required placeholder="9993" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>

      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="block text-slate-400">Interfaces</label>
          <button type="button" @click="instanceForm.interfacesList.push('all')" class="px-2 py-0.5 bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-400 rounded text-[10px] font-semibold flex items-center space-x-1 transition">
            <i data-lucide="plus" class="w-3 h-3"></i>
            <span>Tambah Interfaces</span>
          </button>
        </div>

        <div class="space-y-2">
          <template x-for="(ifaceVal, index) in instanceForm.interfacesList" :key="index">
            <div class="flex items-center space-x-2">
              <select x-model="instanceForm.interfacesList[index]" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono text-xs">
                <option value="all">all</option>
                <option value="dynamic">dynamic</option>
                <option value="none">none</option>
                <option value="static">static</option>
                <optgroup label="--- Router Interfaces ---">
                  <template x-for="iface in (resultData.interfaces || [])" :key="iface['.id'] || iface.name">
                    <option :value="iface.name" x-text="iface.name"></option>
                  </template>
                </optgroup>
              </select>

              <!-- Tombol Hapus Baris (-) -->
              <button type="button" @click="instanceForm.interfacesList.splice(index, 1)" 
                      class="px-2.5 py-2 bg-rose-500/10 hover:bg-rose-500/20 text-rose-500 rounded-lg transition"
                      x-show="instanceForm.interfacesList.length > 1">
                <i data-lucide="minus" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </template>
        </div>
        <p class="text-[10px] text-slate-500 mt-1">Kamu bisa menambahkan lebih dari satu interface.</p>
      </div>

      <div>
        <label class="block text-slate-400 mb-1">Route Distance</label>
        <input type="number" x-model="instanceForm.routeDistance" required placeholder="1" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>

      <div>
        <label class="block text-slate-400 mb-1">Status</label>
        <select x-model="instanceForm.disabled" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200">
          <option value="false">Running</option>
          <option value="true">Disabled</option>
        </select>
      </div>

      <div class="flex justify-end space-x-2 pt-4">
        <button type="button" @click="showInstanceModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg">Batal</button>
        <button type="submit" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg font-semibold" x-text="isEdit ? 'Simpan Perubahan' : 'Tambah Instance'"></button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- 4. MODAL KONFIRMASI DELETE INSTANCE        -->
<!-- ========================================== -->
<div x-show="showDeleteInstanceModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm" style="display: none;">
  <div @click.outside="showDeleteInstanceModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-sm shadow-xl text-center">
    <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto mb-3">
      <i data-lucide="alert-triangle" class="w-6 h-6"></i>
    </div>
    <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Hapus Instance ZeroTier?</h4>
    <p class="text-xs text-slate-400 mb-4">Tindakan ini akan menghapus instance <span class="text-slate-200 font-mono font-semibold" x-text="deleteTargetName"></span> dari router.</p>
    
    <div class="flex space-x-2 justify-center">
      <button type="button" @click="showDeleteInstanceModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs rounded-lg font-medium">Batal</button>
      <button type="button" @click="confirmDeleteInstance()" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs rounded-lg font-semibold transition">Ya, Hapus</button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL ADD / EDIT STATIC ROUTE              -->
<!-- ========================================== -->
<div x-show="showRouteModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak style="display: none;">
  <div @click.outside="showRouteModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-md shadow-xl space-y-4">
    <div class="flex justify-between items-center pb-2 border-b border-slate-100 dark:border-slate-800">
      <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100" x-text="isEditRoute ? 'Edit Static Route' : 'Tambah Static Route Baru'"></h4>
      <button @click="showRouteModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>
    
    <form @submit.prevent="submitRouteForm()" class="space-y-3 text-xs">
      <div>
        <label class="block text-slate-400 mb-1">Dst. Address (CIDR Subnet)</label>
        <input type="text" x-model="routeForm['dst-address']" placeholder="192.168.50.0/24" required class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>

      <div>
        <label class="block text-slate-400 mb-1">Gateway (IP / Interface)</label>
        <input type="text" x-model="routeForm.gateway" placeholder="10.10.10.1 atau nama interface" required class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="block text-slate-400 mb-1">Distance</label>
          <input type="number" x-model="routeForm.distance" placeholder="1" required class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Routing Table</label>
          <select x-model="routeForm['routing-table']" class="w-full bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 rounded-lg p-2 text-slate-800 dark:text-slate-200 font-mono">
            <template x-for="t in (resultData.routingTables || [])" :key="t['.id'] || t.name">
              <option :value="t.name" x-text="t.name"></option>
            </template>
          </select>
        </div>
      </div>

      <!-- TOGGLE SWITCH UNTUK STATUS ROUTE -->
      <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl p-3 space-y-2 mt-2">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-slate-700 dark:text-slate-300 font-medium block">Route Status</span>
            <span class="text-[10px] text-slate-400 block" x-text="routeForm.disabled === 'false' || routeForm.disabled === false ? 'Status: Enabled (Aktif)' : 'Status: Disabled (Nonaktif)'"></span>
          </div>
          
          <button type="button" 
                  @click="routeForm.disabled = (routeForm.disabled === 'false' || routeForm.disabled === false ? 'true' : 'false')"
                  class="w-10 h-5 flex items-center rounded-full p-1 transition-colors duration-300"
                  :class="routeForm.disabled === 'false' || routeForm.disabled === false ? 'bg-emerald-600' : 'bg-slate-700'">
            <div class="bg-white w-3.5 h-3.5 rounded-full shadow-md transform transition-transform duration-300"
                 :class="routeForm.disabled === 'false' || routeForm.disabled === false ? 'translate-x-5' : 'translate-x-0'"></div>
          </button>
        </div>
      </div>

      <div class="flex justify-end space-x-2 pt-3">
        <button type="button" @click="showRouteModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg">Batal</button>
        <button type="submit" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg font-semibold" x-text="isEditRoute ? 'Simpan Perubahan' : 'Tambah Route'"></button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL KONFIRMASI DELETE STATIC ROUTE       -->
<!-- ========================================== -->
<div x-show="showDeleteRouteModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak style="display: none;">
  <div @click.outside="showDeleteRouteModal = false" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 w-full max-w-sm shadow-xl text-center space-y-4">
    <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mx-auto">
      <i data-lucide="alert-triangle" class="w-6 h-6"></i>
    </div>
    <div>
      <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Hapus Static Route?</h4>
      <p class="text-xs text-slate-400">Yakin ingin menghapus route tujuan <span class="text-slate-200 font-mono font-semibold" x-text="routeToDeleteTarget"></span>?</p>
    </div>
    <div class="flex space-x-2 justify-center">
      <button type="button" @click="showDeleteRouteModal = false" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs rounded-lg font-medium">Batal</button>
      <button type="button" @click="confirmDeleteRoute()" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs rounded-lg font-semibold transition">Ya, Hapus</button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 5. TOAST NOTIFICATION MODERN               -->
<!-- ========================================== -->
<div x-show="showToast" 
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0 translate-y-2"
     x-transition:enter-end="opacity-100 translate-y-0"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100 translate-y-0"
     x-transition:leave-end="opacity-0 translate-y-2"
     class="fixed bottom-5 right-5 z-50 flex items-center space-x-3 px-4 py-3 rounded-xl shadow-xl border text-xs font-medium"
     :class="toastType === 'success' ? 'bg-slate-900 border-emerald-500/30 text-emerald-400' : 'bg-slate-900 border-rose-500/30 text-rose-400'"
     style="display: none;">
  <i :data-lucide="toastType === 'success' ? 'check-circle-2' : 'alert-circle'" class="w-4 h-4 flex-shrink-0"></i>
  <span x-text="toastMessage"></span>
</div>