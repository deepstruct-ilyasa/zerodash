<header class="h-16 min-h-[4rem] max-h-[4rem] border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/50 backdrop-blur px-4 md:px-6 flex items-center justify-between sticky top-0 z-10 flex-shrink-0">
  <div class="flex items-center space-x-3">
    <!-- Tombol Mobile Menu Hamburger -->
    <button @click="isMobileMenuOpen = !isMobileMenuOpen" class="md:hidden p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg flex items-center justify-center">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <h2 class="text-sm md:text-base font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider" x-text="activeTab"></h2>
  </div>

  <div class="flex items-center space-x-2 md:space-x-3">
    <button @click="toggleTheme()" class="p-2 text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center rounded-lg">
      <i :data-lucide="darkMode ? 'sun' : 'moon'" :class="darkMode ? 'text-amber-400' : 'text-slate-600 dark:text-slate-300'" class="w-6 h-6"></i>
    </button>
  </div>
</header>