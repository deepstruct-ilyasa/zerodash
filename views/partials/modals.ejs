    <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Tambah Controller Network Baru</h3>
    <div>
      <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Controller Name</label>
      <input type="text" x-model="newNet.name" placeholder="Name_Controller" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200">
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Instance</label>
