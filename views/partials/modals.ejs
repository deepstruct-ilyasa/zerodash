          <option value="">-- Pilih Instance --</option>
          <template x-for="inst in instances" :key="inst['.id'] || inst.name">
            <option :value="inst.name" x-text="inst.name"></option>
          </template>
        </select>
      </div>
      <div>
        <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">MTU Size</label>
        <input type="text" x-model="newNet.mtu" placeholder="2800" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200 font-mono">
      </div>
    </div>
    <div>
      <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">IP Range</label>
      <input type="text" x-model="newNet['ip-range']" placeholder="10.10.10.1-10.10.10.30" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200 font-mono">
    </div>
    <div>
      <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Network Type</label>
      <select x-model="newNet.private" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200">
