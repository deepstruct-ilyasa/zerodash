<!-- MODAL: ADD CONTROLLER ROUTE -->
<div x-show="showAddRouteModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak>
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl max-w-md w-full p-6 space-y-4 shadow-2xl">
    <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">Tambah Subnet Route Baru</h3>
    <p class="text-xs text-slate-400">Tambahkan rute jaringan yang akan didorong secara otomatis ke seluruh member ZeroTier pada controller terpilih.</p>
    
    <div>
      <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Destination Subnet (CIDR)</label>
      <input type="text" x-model="newRoute.subnet" placeholder="192.168.50.0/24" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200 font-mono">
    </div>

    <div>
      <label class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Gateway / Via IP Member (Dropdown)</label>
      <select x-model="newRoute.gateway" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-lg p-2.5 text-xs text-slate-800 dark:text-slate-200 font-mono">
        <option value="">-- Direct Access (Tanpa Gateway Khusus) --</option>
        <template x-for="member in membersForSelectedController" :key="member['.id'] || member['zt-address']">
          <option :value="member['ip-address']" x-text="`${member.name || 'Unnamed Member'} (${member['ip-address'] || 'No IP'})`"></option>
        </template>
      </select>
      <span class="text-[10px] text-slate-400 mt-1 block">Pilih member terdaftar yang bertindak sebagai exit node/gateway untuk subnet tersebut.</span>
    </div>

    <div class="flex items-center justify-end space-x-3 pt-3">
      <button @click="showAddRouteModal = false" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-semibold">Batal</button>
      <button @click="submitAddRoute()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold shadow">Simpan Route</button>
    </div>
  </div>
</div>

