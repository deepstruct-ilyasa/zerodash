        <option :value="false">PUBLIC</option>
      </select>
    </div>
    <div class="flex items-center justify-end space-x-3 pt-2">
      <button @click="showAddNetModal = false" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-semibold">Batal</button>
      <button @click="submitAddNetwork()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg text-xs font-semibold">Simpan Network</button>
    </div>
  </div>
</div>

